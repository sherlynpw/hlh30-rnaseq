nextflow.enable.dsl = 2

plugins {
    id 'nf-schema@2.3.0'
}

params {
    // Run identifier - used to namespace output (e.g. 'VZRJXQ-ruv-rbe')
    id                      = null

    // Input
    input                   = null  // Path to samplesheet YAML
    rnaseq_outdir           = null  // Path to nf-core/rnaseq output (from run.sh step 1)

    // Organism
    organism = [
        genome:           'WBcel235',
        gtf:              null,     // Path to GTF
        ensembl_release:  115,
        kegg_org:         'cel',
        org_db:           'org.Ce.eg.db',
        biomart_dataset:  'celegans_gene_ensembl',
        gene_db:          null      // Path to gene_db.sqlite (built by bin/build_gene_db.R)
    ]


    // DESeq2
    deseq2 = [
        padj_threshold:   0.05,
        lfc_threshold:    1.0,
        shrinkage:        'apeglm',
        condition_from:   'genotype_timepoint',
        reference:        null,
        batch:            null,     // Optional batch covariate column name
        // Compound contrasts: linear combinations of fitted coefficients beyond
        // the default pairwise-vs-reference set. Keys are output file names; values
        // are maps of resultsNames(dds) -> numeric weight. Empty = skipped.
        // Run once first to see resultsNames(dds) printed in the deseq2 log, then
        // wire weights here. Compound contrasts land in contrast_results/<name>.csv
        // and are NOT fed into downstream GO/KEGG/GSEA (they're a separate channel
        // for ad-hoc use, e.g. ssGSEA gene-driver plots).
        contrasts:        [:]
    ]

    // RUVSeq - optional unwanted-variation factor estimation
    ruvseq = [
        enabled:        false,
        method:         'RUVs',     // RUVs | RUVg | RUVr (only RUVs implemented)
        k:              1,           // Number of W factors
        anchor_groups:  null         // Optional TSV (sample_id,group); null = group by condition
    ]

    // Sample groups for analysis
    groups                  = [:]

    // Clustering
    clustering = [
        num_clusters:                 'auto',
        cluster_range:                '2,12',
        sort_by:                      'pvalue',
        correct_vst:                  false,
        condition_order:              '',         // e.g. 'N2_L4,N2_Day3,hlh-30_L4,hlh-30_Day3'
        hierarchical_num_clusters:     null,              // null = use num_clusters (and trigger auto-method when 'auto')
        hierarchical_linkage:          'ward.D2',         // hclust method: ward.D2 | average | complete | single
        hierarchical_distance:         'euclidean',       // euclidean | correlation
        hierarchical_auto_method:      'dynamic_tree_cut',// auto-k method: dynamic_tree_cut | silhouette
        hierarchical_deep_split:       2,                 // dynamicTreeCut deepSplit (0-4); higher = more, smaller clusters
        hierarchical_min_cluster_size: 30,                // dynamicTreeCut minClusterSize
        hierarchical_max_plot_genes:   2000               // heatmap row cap (full assignments preserved)
    ]

    // Enrichment - each type filters DESeq2 results by its own threshold
    enrichment = [
        compare_de: true,    // Set to false to skip COMPARE_DE + its GO/KEGG/WormCat dependents
        go: [
            enabled:     true,
            padj_filter: 'padj',   // 'padj' or 'pvalue'
            padj:        0.05,
            lfc:         0         // 0 = no LFC filter
        ],
        kegg: [
            enabled:     true,
            padj_filter: 'padj',
            padj:        0.05,
            lfc:         0
        ],
        wormcat: [
            enabled:     true,
            padj_filter: 'pvalue', // pvalue (more lenient, matches old pipeline)
            padj:        0.05
        ],
        gsea: [
            enabled:              true,
            ranking:              'stat',      // all genes, no filter - ranked by DESeq2 stat
            min_size:             15,
            max_size:             500,
            collections:          ['go', 'kegg'],
            hallmark_gmt:         null,
            curated_gmt:          null,
            custom_gene_set_file: null,
            custom_gene_set_name: 'custom_gene_set',
            custom_gene_set_format: 'list',
            custom_gene_set_map_ortholog: false,
            ortholog_map:         null,
            ortholog_from:        'wormbase_gene',
            ortholog_to:          'human_symbol'
        ],
        // ssGSEA - per-sample gene-set scores on VST counts (RUV-corrected when available).
        // Reuses enrichment.gsea.collections + ortholog map by default. Complements GSEA:
        // GSEA tests per-contrast enrichment; ssGSEA gives a sample x pathway matrix for
        // PCA/heatmaps and lets limma test interaction terms (e.g. genotype x timepoint).
        ssgsea: [
            enabled:        true,
            method:         'ssgsea',  // gsva method: ssgsea, gsva, plage, zscore
            min_size:       15,
            max_size:       500,
            heatmap_top_n:  30,
            // limma model fit on the score matrix. Null = score-only output (no stats).
            // For two genotypes across timepoints, try '~ genotype * timepoint'.
            formula:        null,
            // Coefficients to extract toptables for; empty = all non-intercept terms.
            coefficients:   [],
            // Meta columns used to color the pathway-space PCA; empty = all meta cols.
            color_by:       [],
            // Factor reference levels (map of column → level). Sets the baseline for
            // model.matrix() so limma coefficient names are predictable.
            reference_levels: [:],
            // Per-coefficient visualizations (volcano, dotplot, boxplots, trajectories)
            // are drawn for the top-N pathways from each limma toptable. top_pathways
            // is the default for panel grids (boxplots/trajectories — panel legibility
            // caps at ~16). dotplot_top_n and volcano_label_n override for those plots;
            // null falls back to top_pathways.
            top_pathways:     12,
            dotplot_top_n:    20,
            volcano_label_n:  15,
            // Trajectory plot: x-axis column (e.g. 'timepoint') and color column
            // (e.g. 'genotype'). Skipped if trajectory_x is unset.
            trajectory_x:     null,
            trajectory_group: null,
            // Boxplot x-axis: list of meta columns; combined as interaction (e.g.
            // ['genotype', 'timepoint'] → 'N2_L4'). Skipped if empty.
            box_x:            [],
            // Optional override of builtin gene-set list (e.g. ['go', 'kegg']).
            // null = reuse enrichment.gsea.builtin. External GMTs always come from
            // enrichment.gsea.collections via the shared manifest.
            builtin:        null,
            // Named linear contrasts on the limma fit. Each entry is a linear combination
            // of design coefficients, e.g. for "mutant vs WT at Day3":
            //   "genotypemut + genotypemut:timepointDay3"
            // Each named contrast gets its own toptable + volcano/dotplot/boxplots/trajectories
            // under limma/<name>/. Interaction-term coefficients (containing ':') are auto-quoted.
            contrasts:      [:],
            // Gene-driver bar plots: for each ssGSEA term, locate the matching
            // DESeq2 CSV by name (or via de_mapping override) and render a
            // faceted bar plot of pathway-member log2FC for the top pathways.
            // Top genes per pathway (ranked by |log2FC|).
            driver_top_n:   15,
            // Map ssGSEA term -> DESeq2 CSV basename (without .csv). Use when
            // the ssGSEA limma coefficient name doesn't match a DESeq2 contrast
            // file name. Compound contrasts (defined in both blocks with matching
            // names) auto-match without an entry here.
            de_mapping:     [:],
            // Heatmap column ordering. column_order_cols defines the meta columns
            // combined with "_" to build each sample's group key. column_order is
            // the desired sequence of those keys (e.g. "N2_L4,N2_Day3,...").
            // If column_order is null, falls back to clustering.condition_order.
            // Setting either disables column clustering on the variance heatmap.
            column_order_cols: ['genotype', 'timepoint'],
            column_order:      null
        ]
    ]

    // Exploration
    exploration = [
        pca_color_by:  [],  // Samplesheet columns to color PCA/UMAP by; empty = all metadata columns
    ]

    // Per-stage skip flags, such as for a PCA-only run.
    skip_exploration = false
    skip_clustering  = false
    skip_enrichment  = false

    // Output
    outdir                  = './results'
    publish_dir_mode        = 'copy'

    // nf-core/rnaseq options (for FASTQ inputs)
    aligner                 = 'star_salmon'
    skip_alignment          = false

    // Max resource limits
    max_cpus                = 16
    max_memory              = '64.GB'
    max_time                = '24.h'
}

// Allow all tasks to be submitted at once
executor {
    queueSize   = 50
    submitRateLimit = '10/1min'
}

// Load base resource config
includeConfig 'conf/base.config'

profiles {
    local {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    aws {
        includeConfig 'conf/aws.config'
    }

    gcp {
        includeConfig 'conf/gcp.config'
    }

    test {
        params {
            max_cpus   = 4
            max_memory = '8.GB'
            max_time   = '2.h'
        }
    }
}

// Seqera Platform (optional - set TOWER_ACCESS_TOKEN to enable)
tower {
    enabled     = System.getenv('TOWER_ACCESS_TOKEN') ? true : false
    accessToken = System.getenv('TOWER_ACCESS_TOKEN') ?: ''
}

manifest {
    name            = 'celegans-pipeline'
    author          = 'Ray Andrew'
    description     = 'C. elegans RNA-seq analysis pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '0.1.0'
}
