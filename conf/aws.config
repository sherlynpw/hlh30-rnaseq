// AWS Batch configuration
// aws CLI is installed inside the container image

aws {
    region = 'us-east-1'
    batch {
        jobRole         = "arn:aws:iam::${System.getenv('AWS_ACCOUNT_ID')}:role/NfJobRole"   // set by scripts/env.sh
        maxSpotAttempts = 3
    }
}

process {
    executor = 'awsbatch'
    queue    = 'nf-queue'

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 3
}

// Explicitly disable Wave/Fusion - use aws CLI in container for S3 staging
wave.enabled   = false
fusion.enabled = false

workDir = 's3://celegans-pipeline-rayandrew/work'

params {
    outdir = 's3://celegans-pipeline-rayandrew/results'
}
