process {
    executor    = 'google-batch'
    machineType = 'e2-standard-4'
    spot        = true

    // Retry on preemption
    errorStrategy = { task.exitStatus in [50001] ? 'retry' : 'finish' }
    maxRetries    = 3
}

google {
    project  = 'your-project-id'
    location = 'us-central1'
}

fusion {
    enabled = true
}

wave {
    enabled = true
}

params {
    outdir = 'gs://celegans-pipeline/results'
}
