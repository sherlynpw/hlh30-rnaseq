process {
    cpus   = { 1    * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 2.h  * task.attempt }

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: 'process_low' {
        cpus   = { 2     * task.attempt }
        memory = { 4.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }

    withLabel: 'process_medium' {
        cpus   = { 4     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withLabel: 'process_high' {
        cpus   = { 8     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withLabel: 'process_high_memory' {
        cpus   = { 4     * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    // featureCounts is fast, low resources
    withName: 'FEATURECOUNTS' {
        cpus   = { 4     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 1.h   * task.attempt }
    }

    // DESeq2 can be memory-hungry with many samples
    withName: 'DESEQ2' {
        cpus   = { 2     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }

    // Clustering processes
    withName: 'MFUZZ_CLUSTERING|FUZZY_CLUSTERING|HDBSCAN_CLUSTERING' {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 1.h   * task.attempt }
    }

    // Enrichment processes (may call external APIs)
    withName: 'GO_ENRICHMENT|KEGG_ENRICHMENT|WORMCAT|GSEA' {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }

    // Compare-DE enrichment runs ~100 gene lists in parallel - give it more cores
    withName: 'GO_COMPARE|KEGG_COMPARE|WORMCAT_COMPARE' {
        cpus   = { 8     * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // Lightweight processes
    withName: 'PCA|UMAP|CV_DENSITY|FILTER_DE|ANNOTATE_GENES|COMPARE_DE' {
        cpus   = { 2     * task.attempt }
        memory = { 4.GB  * task.attempt }
        time   = { 30.min * task.attempt }
    }
}

// Prevent exceeding resource limits
if (params.max_cpus) {
    process.cpus   = { Math.min(process.cpus as int, params.max_cpus as int) }
}
if (params.max_memory) {
    process.memory = { [process.memory as nextflow.util.MemoryUnit, params.max_memory as nextflow.util.MemoryUnit].min() }
}
if (params.max_time) {
    process.time   = { [process.time as nextflow.util.Duration, params.max_time as nextflow.util.Duration].min() }
}
